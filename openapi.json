{
  "openapi": "3.0.3",
  "info": {
    "title": "Coinbase Portfolio API",
    "description": "Read-only live Coinbase portfolio and USD market data.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/portfolio/holdings": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Get current non-zero Coinbase holdings",
        "description": "Returns current non-zero Coinbase asset balances, quantities, USD values, and allocation percentages. Use for owned assets or portfolio composition.",
        "operationId": "get_holdings",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "include_cost_basis",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include cost basis and unrealized P&L per holding, derived from fills history.",
              "default": false,
              "title": "Include Cost Basis"
            },
            "description": "Include cost basis and unrealized P&L per holding, derived from fills history."
          },
          {
            "name": "include_market_context",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include CoinGecko market cap rank and market cap per holding, for interpretation and analysis.",
              "default": false,
              "title": "Include Market Context"
            },
            "description": "Include CoinGecko market cap rank and market cap per holding, for interpretation and analysis."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldingsResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio/summary": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Get the user's current Coinbase portfolio value and summarized positions",
        "description": "Returns the user's current Coinbase portfolio value and summarized positions. Use for total portfolio value or overall portfolio status.",
        "operationId": "get_portfolio_summary",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "include_cost_basis",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include aggregate cost basis and unrealized P&L, derived from fills history.",
              "default": false,
              "title": "Include Cost Basis"
            },
            "description": "Include aggregate cost basis and unrealized P&L, derived from fills history."
          },
          {
            "name": "include_market_context",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include CoinGecko market cap rank and market cap on top holdings, for interpretation and analysis.",
              "default": false,
              "title": "Include Market Context"
            },
            "description": "Include CoinGecko market cap rank and market cap on top holdings, for interpretation and analysis."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSummaryResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/market/{product_id}": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Get a live Coinbase USD product price",
        "description": "Returns the current Coinbase price for a requested product such as BTC-USD or ETH-USD. Use for live price questions.",
        "operationId": "get_market_price",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketPriceResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/market/{product_id}/history": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Get normalized Coinbase USD candle history",
        "description": "Returns Coinbase-only candle history and deterministic price-risk metrics. Approved period/granularity combinations cap output at 150 candles.",
        "operationId": "get_market_history",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "1y"
              ],
              "type": "string",
              "default": "7d",
              "title": "Period"
            }
          },
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "1h",
                "6h",
                "1d"
              ],
              "type": "string",
              "default": "1h",
              "title": "Granularity"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketHistoryResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/market/{product_id}/context": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Get mapped CoinGecko market context",
        "description": "Returns broader optional CoinGecko context for explicitly mapped Coinbase assets. Unmapped assets and CoinGecko failures return null fields without substituting another asset.",
        "operationId": "get_market_context",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketContextResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio/history": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Get persisted portfolio value history",
        "description": "Returns only manually captured SQLite snapshots. Change fields describe value change, not cash-flow-adjusted investment return.",
        "operationId": "get_portfolio_history",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "1y",
                "all"
              ],
              "type": "string",
              "default": "30d",
              "title": "Period"
            }
          },
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "hour",
                "day"
              ],
              "type": "string",
              "default": "day",
              "title": "Granularity"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio/analytics": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Get portfolio value, concentration, and benchmark analytics",
        "description": "Combines live holdings, persisted snapshots, and aligned Coinbase benchmark candles. Value changes are not investment returns.",
        "operationId": "get_portfolio_analytics",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "1y",
                "all"
              ],
              "type": "string",
              "default": "30d",
              "title": "Period"
            }
          },
          {
            "name": "benchmark",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{2,20}-USD$",
              "default": "BTC-USD",
              "title": "Benchmark"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioAnalyticsResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "message": {
            "title": "Message",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorDetail"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryPoint": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "total_value": {
            "type": "string",
            "title": "Total Value"
          },
          "crypto_value": {
            "title": "Crypto Value",
            "type": "string",
            "nullable": true
          },
          "cash_value": {
            "title": "Cash Value",
            "type": "string",
            "nullable": true
          },
          "priced_value": {
            "title": "Priced Value",
            "type": "string",
            "nullable": true
          },
          "unknown_price_count": {
            "title": "Unknown Price Count",
            "type": "integer",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "total_value"
        ],
        "title": "HistoryPoint"
      },
      "Holding": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity"
          },
          "price": {
            "title": "Price",
            "description": "USD price; null when Coinbase has no SYMBOL-USD product (unknown, not zero).",
            "type": "string",
            "nullable": true
          },
          "value": {
            "title": "Value",
            "description": "quantity * price; null when price is null.",
            "type": "string",
            "nullable": true
          },
          "allocation_pct": {
            "title": "Allocation Pct",
            "description": "Percent of total valued holdings; null when value is null or the portfolio total is zero.",
            "type": "string",
            "nullable": true
          },
          "cost_basis": {
            "title": "Cost Basis",
            "description": "Average-cost basis in USD, derived from fills history. Present only when include_cost_basis=true. Null = unknown (no fills history for this asset), not zero.",
            "type": "string",
            "nullable": true
          },
          "unrealized_pnl": {
            "title": "Unrealized Pnl",
            "description": "value - cost_basis. Same availability as cost_basis.",
            "type": "string",
            "nullable": true
          },
          "unrealized_pnl_pct": {
            "title": "Unrealized Pnl Pct",
            "description": "unrealized_pnl / cost_basis * 100. Null if cost_basis is null or zero.",
            "type": "string",
            "nullable": true
          },
          "market_cap_rank": {
            "title": "Market Cap Rank",
            "description": "CoinGecko market cap rank. Present only when include_market_context=true. Null = not listed on CoinGecko, not unranked-zero.",
            "type": "integer",
            "nullable": true
          },
          "market_cap": {
            "title": "Market Cap",
            "description": "USD market cap. Same availability as market_cap_rank.",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "name",
          "quantity",
          "price",
          "value",
          "allocation_pct"
        ],
        "title": "Holding"
      },
      "HoldingsResponse": {
        "properties": {
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "holdings": {
            "items": {
              "$ref": "#/components/schemas/Holding"
            },
            "type": "array",
            "title": "Holdings"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "cost_basis_available": {
            "title": "Cost Basis Available",
            "description": "Null when include_cost_basis=false. False when the fills lookup failed upstream (holdings' cost_basis fields are then all null). True otherwise.",
            "type": "boolean",
            "nullable": true
          },
          "market_context_available": {
            "title": "Market Context Available",
            "description": "Null when include_market_context=false. False when CoinGecko failed upstream. True otherwise.",
            "type": "boolean",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "currency",
          "holdings",
          "retrieved_at"
        ],
        "title": "HoldingsResponse"
      },
      "MarketCandle": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "open": {
            "type": "string",
            "title": "Open"
          },
          "high": {
            "type": "string",
            "title": "High"
          },
          "low": {
            "type": "string",
            "title": "Low"
          },
          "close": {
            "type": "string",
            "title": "Close"
          },
          "volume": {
            "type": "string",
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "MarketCandle"
      },
      "MarketContextResponse": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          },
          "market_context_available": {
            "type": "boolean",
            "title": "Market Context Available"
          },
          "coin_id": {
            "title": "Coin Id",
            "type": "string",
            "nullable": true
          },
          "market_cap_rank": {
            "title": "Market Cap Rank",
            "type": "integer",
            "nullable": true
          },
          "market_cap": {
            "title": "Market Cap",
            "type": "string",
            "nullable": true
          },
          "fully_diluted_valuation": {
            "title": "Fully Diluted Valuation",
            "type": "string",
            "nullable": true
          },
          "circulating_supply": {
            "title": "Circulating Supply",
            "type": "string",
            "nullable": true
          },
          "total_supply": {
            "title": "Total Supply",
            "type": "string",
            "nullable": true
          },
          "max_supply": {
            "title": "Max Supply",
            "type": "string",
            "nullable": true
          },
          "ath": {
            "title": "Ath",
            "type": "string",
            "nullable": true
          },
          "ath_change_pct": {
            "title": "Ath Change Pct",
            "type": "string",
            "nullable": true
          },
          "total_volume": {
            "title": "Total Volume",
            "type": "string",
            "nullable": true
          },
          "volume_market_cap_ratio": {
            "title": "Volume Market Cap Ratio",
            "type": "string",
            "nullable": true
          },
          "change_24h_pct": {
            "title": "Change 24H Pct",
            "type": "string",
            "nullable": true
          },
          "change_7d_pct": {
            "title": "Change 7D Pct",
            "type": "string",
            "nullable": true
          },
          "change_30d_pct": {
            "title": "Change 30D Pct",
            "type": "string",
            "nullable": true
          },
          "change_1y_pct": {
            "title": "Change 1Y Pct",
            "type": "string",
            "nullable": true
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "market_context_available",
          "coin_id",
          "market_cap_rank",
          "market_cap",
          "fully_diluted_valuation",
          "circulating_supply",
          "total_supply",
          "max_supply",
          "ath",
          "ath_change_pct",
          "total_volume",
          "volume_market_cap_ratio",
          "change_24h_pct",
          "change_7d_pct",
          "change_30d_pct",
          "change_1y_pct",
          "retrieved_at"
        ],
        "title": "MarketContextResponse"
      },
      "MarketHistoryResponse": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          },
          "period": {
            "type": "string",
            "title": "Period"
          },
          "granularity": {
            "type": "string",
            "title": "Granularity"
          },
          "candles": {
            "items": {
              "$ref": "#/components/schemas/MarketCandle"
            },
            "type": "array",
            "title": "Candles"
          },
          "point_count": {
            "type": "integer",
            "title": "Point Count"
          },
          "change_value": {
            "title": "Change Value",
            "type": "string",
            "nullable": true
          },
          "change_pct": {
            "title": "Change Pct",
            "type": "string",
            "nullable": true
          },
          "high": {
            "title": "High",
            "type": "string",
            "nullable": true
          },
          "low": {
            "title": "Low",
            "type": "string",
            "nullable": true
          },
          "max_drawdown_pct": {
            "title": "Max Drawdown Pct",
            "type": "string",
            "nullable": true
          },
          "realized_volatility_pct": {
            "title": "Realized Volatility Pct",
            "description": "Annualized sample volatility of log returns; null with fewer than two returns.",
            "type": "string",
            "nullable": true
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "period",
          "granularity",
          "candles",
          "point_count",
          "change_value",
          "change_pct",
          "high",
          "low",
          "max_drawdown_pct",
          "realized_volatility_pct",
          "retrieved_at"
        ],
        "title": "MarketHistoryResponse"
      },
      "MarketPriceResponse": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "price": {
            "type": "string",
            "title": "Price"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "change_24h_pct": {
            "title": "Change 24H Pct",
            "description": "24h percent change. Null when candle history is unavailable, not zero change.",
            "type": "string",
            "nullable": true
          },
          "change_7d_pct": {
            "title": "Change 7D Pct",
            "description": "7d percent change. Null when candle history is unavailable, not zero change.",
            "type": "string",
            "nullable": true
          },
          "bid": {
            "title": "Bid",
            "description": "Best bid. Null when the order book is empty or unavailable.",
            "type": "string",
            "nullable": true
          },
          "ask": {
            "title": "Ask",
            "description": "Best ask. Null when the order book is empty or unavailable.",
            "type": "string",
            "nullable": true
          },
